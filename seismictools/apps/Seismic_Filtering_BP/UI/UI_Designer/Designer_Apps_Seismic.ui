  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #1e1e1e;
	font-size: 12pt;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #333;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 5px;
    background-color: #2d2d2d;
    color: #ffffff;
	font-size: 12pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #ffffff;
	font-size: 12pt;
}


/*Кнопка с выбором порядка фильтра*/
QSpinBox {
    background-color: #333;
    border: 1px solid #555;
    border-radius: 12px;
    padding: 5px;
    color: #ffffff;
    font-size: 12pt;
}


QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 18px;
    border-left: 1px solid #555;
    border-radius: 9px;
    background-color: #444;
    margin-right: 3px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 18px;
    border-left: 1px solid #555;
    border-radius: 9px;
    background-color: #444;
    margin-right: 3px; 
}

QSpinBox::up-arrow {
    width: 10px;
    height: 10px;
	color: #ffffff;
}

QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
	color: #ffffff;
}

/*Текстовые поля*/
QLabel {
    color: #ffffff;
    font-size: 12pt;
}

QLineEdit {
    border: 1px solid #555;
    border-radius: 10px;
    padding: 5px;
    background-color: #333;
    color: #ffffff;
	font-size: 12pt;
}

/*Кнопка с выбором фильтра*/
QComboBox {
    border: 1px solid #555;
    border-radius: 12px;
    padding: 5px;
    background-color: #333;
    color: #ffffff;
	font-size: 12pt;
	text-align: center;
}

QComboBox::drop-down {
    border: none;
    width: 0px;
}

QComboBox::down-arrow {
    image: none;
}


/* Кнопка &quot;Загрузить&quot; */
#pushButton_load {
    background-color: #ff3b30;
    border: none;
    border-radius: 12px;
    padding: 8px 16px;
    font-weight: bold;
    color: white;
    font-size: 12pt;
}

#pushButton_load:hover {
    background-color: #ff574d;
}

#pushButton_load:pressed {
    background-color: #ff2a1f;
}

/* Кнопка &quot;Очистить&quot;*/
#pushButton_clear {
    background-color: #555;
    border: none;
    border-radius: 12px;
    padding: 8px 16px;
    font-weight: bold;
    color: #ffffff;
    font-size: 12pt;
}

#pushButton_clear:hover {
    background-color: #666;
}

#pushButton_clear:pressed {
    background-color: #444;
}

/* Кнопка &quot;Применить&quot;*/
#pushButton_apply {
    background-color: #ff3b30;
    border: none;
    border-radius: 12px;
    padding: 8px 16px;
    font-weight: bold;
    color: white;
    font-size: 12pt;
}

#pushButton_apply:hover {
    background-color: #ff574d;
}

#pushButton_apply:pressed {
    background-color: #ff2a1f;
}

/* Кнопка &quot;Сбросить&quot;*/
#pushButton_reset {
    background-color: #555;
    border: none;
    border-radius: 12px;
    padding: 8px 16px;
    font-weight: bold;
    color: #ffffff;
    font-size: 12pt;
}

#pushButton_reset:hover {
    background-color: #666;
}

#pushButton_reset:pressed {
    background-color: #444;
}</string>
