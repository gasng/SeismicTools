  <property name="styleSheet">
   <string notr="true">/* Light theme QSS stylesheet */

/* Base window */
QMainWindow, QWidget {
    background-color: #f5f5f7;
    color: #202124;
    font-family: &quot;Segoe UI&quot;, &quot;Roboto&quot;, &quot;Sans-Serif&quot;;
    font-size: 10pt;
}

/* Labels */
QLabel {
    color: #202124;
}

/* Line edits, text edits, combo boxes, spin boxes */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #cde4ff;
    selection-color: #202124;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #1a73e8;
}

/* Buttons */
QPushButton {
    background-color: #1a73e8;
    color: #ffffff;
    border-radius: 4px;
    padding: 4px 10px;
    border: 1px solid #185abc;
}

QPushButton:hover {
    background-color: #1967d2;
}

QPushButton:pressed {
    background-color: #174ea6;
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #9e9e9e;
    border-color: #d0d0d0;
}

/* Tool buttons */
QToolButton {
    background: transparent;
    border-radius: 4px;
    padding: 3px 6px;
}

QToolButton:hover {
    background-color: #e8f0fe;
}

/* Checkboxes and radio buttons */
QCheckBox, QRadioButton {
    spacing: 6px;
    color: #202124;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #d0d7de;
    border-radius: 4px;
    margin-top: 8px;
    padding: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 3px;
    color: #5f6368;
}

/* Menubar */
QMenuBar {
    background-color: #f5f5f7;
}

QMenuBar::item {
    padding: 3px 8px;
}

QMenuBar::item:selected {
    background-color: #e8f0fe;
}

/* Menus */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
}

QMenu::item {
    padding: 4px 18px 4px 24px;
}

QMenu::item:selected {
    background-color: #e8f0fe;
}

/* Status bar */
QStatusBar {
    background-color: #f5f5f7;
    border-top: 1px solid #d0d7de;
}

/* Scroll bars (simple, minimal) */
QScrollBar:vertical {
    background: #f5f5f7;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #c0c4cc;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #a6aab2;
}

QScrollBar:horizontal {
    background: #f5f5f7;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #c0c4cc;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #a6aab2;
}

/* Table and list views */
QTableView,
QTreeView,
QListView {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    selection-background-color: #e8f0fe;
    selection-color: #202124;
}

/* Headers */
QHeaderView::section {
    background-color: #f1f3f4;
    padding: 4px;
    border: 1px solid #d0d7de;
    font-weight: 500;
}
</string>
