  <property name="styleSheet">
   <string notr="true">/* Основной стиль — тёмная тема */
QWidget {
    background-color: #2d2d2d;
    color: #e6e6e6;
    font-family: &quot;Segoe UI&quot;, &quot;Noto Sans&quot;, sans-serif;
    font-size: 10pt;
}

/* Кнопки — округлые, с границей, хорошо различимы */
QPushButton {
    background-color: #3e3e3e;
    border: 1px solid #555555;
    border-radius: 10px;
    padding: 8px 16px;
    color: #ffffff;
    min-width: 80px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4c4c4c;
    border: 1px solid #666666;
}

QPushButton:pressed {
    background-color: #2a2a2a;
    border: 1px solid #444444;
}

QPushButton:disabled {
    background-color: #353535;
    color: #888888;
    border: 1px solid #444444;
}

/* RadioButton — теперь чётко виден, включая выбранное состояние */
QRadioButton {
    color: #e6e6e6;
    background-color: transparent;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #777777;
    border-radius: 8px;
    background-color: #252525;
}

QRadioButton::indicator:hover {
    border: 2px solid #aaaaaa;
}

QRadioButton::indicator:checked {
    border: 2px solid #00a8ff;
    background-color: #00a8ff;
}

QRadioButton::indicator:checked:hover {
    border: 2px solid #33ccff;
    background-color: #00a8ff;
}

/* Заголовки таблиц — тёмные с белым текстом */
QHeaderView::section {
    background-color: #333333;
    color: #ffffff;
    padding: 6px;
    border: 1px solid #444444;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #3a3a3a;
}

/* Таблицы */
QTableWidget, QTableView {
    background-color: #252525;
    alternate-background-color: #2a2a2a;
    gridline-color: #3c3c3c;
    selection-background-color: #005682;
    selection-color: #ffffff;
    border: 1px solid #444444;
}

/* Поля ввода */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 5px;
    color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #0078d7;
}

/* Скроллбар */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #2b2b2b;
    border: none;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #444444;
    border-radius: 4px;
    min-height: 20px;
    min-width: 20px;
}

QScrollBar::handle:hover {
    background: #555555;
}</string>
