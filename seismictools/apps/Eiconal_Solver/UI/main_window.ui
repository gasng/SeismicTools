  <property name="styleSheet">
   <string notr="true">/* Главное окно — чистый белый фон */
QMainWindow {
    background-color: #ffffff;
}

/* Заголовок приложения — мягкий овальный блок с тенью */
QLabel#Label {
    font-size: 20px;
    font-weight: bold;
    color: #FF8C42;
    padding: 10px 20px;
    margin: 10px 0 15px 0;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #FFF2E8,
        stop: 1 #FFE6D5
    );
    border-radius: 20px;
    border: 1px solid #FFD0B0;
    min-width: 180px;
    text-align: center;
}

/* Группы — с мягкими тенями и оранжевыми заголовками */
QGroupBox {
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    margin-top: 16px;
    background: #ffffff;
    padding: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    color: #FF8C42;
    font-weight: bold;
    background: transparent;
    border-left: 3px solid #FF8C42;
}

/* Кнопки — с градиентом от розового к оранжевому */
QPushButton {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #FF9A76,
        stop: 1 #FF8C42
    );
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: white;
    font-weight: bold;
    min-width: 80px;
    box-shadow: 0 2px 4px rgba(255, 140, 66, 0.2);
}
QPushButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #FF7F50,
        stop: 1 #FF6B2F
    );
}
QPushButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #E06320,
        stop: 1 #D0531A
    );
    padding: 9px 17px 7px 15px;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
}

/* Особая кнопка &quot;Старт&quot; — ярче, как на макете */
QPushButton#StartButton {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #FF6B9D,
        stop: 1 #FF5A8C
    );
    box-shadow: 0 2px 6px rgba(255, 106, 157, 0.3);
}
QPushButton#StartButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #FF5080,
        stop: 1 #FF3F6F
    );
}
QPushButton#StartButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #E04070,
        stop: 1 #D03060
    );
}

/* Поле ввода — светлое, с тонкой границей */
QLineEdit {
    background: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 6px 10px;
    color: #333;
}
QLineEdit:focus {
    border: 1px solid #FF8C42;
    background: #fff;
}

/* Метки координат — небольшие, с мягким фоном */
QLabel#XSource, QLabel#ZSource, QLabel#AngleLabel {
    background: #f5f5f5;
    border-radius: 6px;
    padding: 4px 8px;
    color: #555;
    font-size: 13px;
    min-width: 60px;
    text-align: center;
}

/* Слайдер — оранжевый трек */
QSlider::groove:horizontal {
    height: 6px;
    background: #FFD0B0;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FF8C42;
    border: 1px solid #FF8C42;
    height: 14px;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #FF6B2F;
}

/* Список файлов / статус — с лёгким фоном */
QListWidget {
    background: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 4px;
    color: #444;
}
QListWidget#StatusWidget {
    background: #f8f8f8;
    border-top: 1px solid #e0e0e0;
    color: #666;
    font-size: 11px;
    selection-background-color: #FF8C42;
    selection-color: white;
}

/* Центральный виджет — без фона, чтобы график был на белом */
QWidget#widget {
    background: transparent;
    border: none;
}</string>
